// Simple test for parameter syntax

enum MessageType {
  Data = 1,
  Command = 2,
}

struct DataPayload(subtype: MessageType(u8)) {
  actual_size: u8,
  footer: match subtype {
    Data => u16,
    Command => u32,
  },
}

struct CommandPayload(subtype: MessageType(u8)) {
  command_id: u8,
  extra: match subtype {
    Data => u8,
    Command => [u8; 4],
  },
}

struct Main {
  msg_type: MessageType(u8),
  msg_subtype: MessageType(u8),
  size: u16,
  payload: match msg_type {
    Data => DataPayload(msg_subtype),
    Command => CommandPayload(msg_subtype),
  },
}
